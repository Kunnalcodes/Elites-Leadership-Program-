{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "./dist-server",
    "rootDir": "./",
    "baseUrl": "./",
    "paths": {
      "@server/*": ["server/src/*"],
      "@shared/*": ["server/src/shared/*"],
      "@modules/*": ["server/src/modules/*"],
      "@infrastructure/*": ["server/src/infrastructure/*"]
    }
  },
  "include": ["server/src/**/*", "server/tests/**/*", "prisma/**/*"],
  "exclude": ["node_modules", "dist", "dist-server"]
}
